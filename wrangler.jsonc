// Cloudflare Worker that starts the hourly ingestion on time (code in trigger/src/index.js).
// It lives at the repository root so Cloudflare's default build settings work: Import repository,
// keep the root directory empty and the default commands. The Python package is not part of the Worker.
{
  "$schema": "https://unpkg.com/wrangler@4.151.2/config-schema.json",
  "name": "weather-warehouse",
  "main": "trigger/src/index.js",
  "compatibility_date": "2026-10-19",
  "triggers": {
    // Minute 25 of every hour, UTC — AEMET has usually published the previous hour by then.
    "crons": ["25 * * * *"]
  },
  "vars": {
    "REPO": "6roli/weather-warehouse",
    "WORKFLOW": "hourly.yml",
    "REF": "main"
  },
  "observability": { "enabled": true },
  "previews": {}
}
