# Copy to .env for local runs. Never commit .env.

# Optional: AEMET OpenData key (free, request by e-mail at https://opendata.aemet.es/centrodedescargas/altaUsuario)
AEMET_API_KEY=

# Optional: publish the data lake to a Hugging Face Storage Bucket
# HF_BUCKET=groli/weather-warehouse
# HF_TOKEN=            # token with write access, from https://huggingface.co/settings/tokens

# Optional: local folder for the data lake (default: ./data)
# DATA_DIR=data
